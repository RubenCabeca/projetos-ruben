# Football Analytics - Environment Variables

# ============================================
# API Configuration
# ============================================

# Football-Data.org API key
# ⚠️ SECURITY: This key is server-side only and must not be exposed to the browser.
# Add the key to .env.local and do not commit that file.
# Get your key at: https://www.football-data.org/
FOOTBALL_API_KEY=your_football_data_api_key

# ============================================
# Optional: Alternative or additional configuration
# ============================================

# If you integrate another provider you can add a second key here.
# FOOTBALL_API_ALT_KEY=your_optional_alt_key

# ============================================
# Configuration
# ============================================

# Cache duration in seconds (optional)
# NEXT_PUBLIC_CACHE_DURATION=300

# Enable/disable fallback to mock data when API fails
# NEXT_PUBLIC_USE_FALLBACK=true